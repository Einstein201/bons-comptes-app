datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum WalletStatus {
  OPEN
  CLOSED
}

enum WalletMemberStatus {
  INVITED
  MEMBER
}

enum RepaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum NotificationType {
  INVITATION_RECEIVED
  REPAYMENT_CONFIRMED
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  name               String
  password           String
  sessionVersion     Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  walletMemberships  WalletMember[]
  createdWallets     Wallet[]       @relation("WalletCreator")
  paidExpenses       Expense[]      @relation("ExpensePayer")
  createdExpenses    Expense[]      @relation("ExpenseCreator")
  splits             ExpenseSplit[]
  sentRepayments     Repayment[]    @relation("RepaymentSender")
  receivedRepayments Repayment[]    @relation("RepaymentRecipient")
  notifications      Notification[]
}

model Wallet {
  id          String         @id @default(uuid())
  title       String
  description String?
  status      WalletStatus   @default(OPEN)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closedAt    DateTime?
  createdBy   User           @relation("WalletCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     WalletMember[]
  expenses    Expense[]
  repayments  Repayment[]
}

model WalletMember {
  id         String             @id @default(uuid())
  walletId   String
  userId     String
  status     WalletMemberStatus @default(INVITED)
  invitedAt  DateTime           @default(now())
  acceptedAt DateTime?
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet     Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, userId])
  @@index([userId, status])
}

model Expense {
  id          String         @id @default(uuid())
  walletId    String
  title       String
  amount      Int
  date        DateTime       @db.Date
  createdAt   DateTime       @default(now())
  paidById    String
  createdById String
  wallet      Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paidBy      User           @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy   User           @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  splits      ExpenseSplit[]
}

model ExpenseSplit {
  id        String  @id @default(uuid())
  expenseId String
  userId    String
  amount    Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
}

model Repayment {
  id         String          @id @default(uuid())
  walletId   String
  fromUserId String
  toUserId   String
  amount     Int
  status     RepaymentStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  paidAt     DateTime?
  wallet     Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  fromUser   User            @relation("RepaymentSender", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser     User            @relation("RepaymentRecipient", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([walletId, status])
}

// walletId est volontairement sans clé étrangère : supprimer un porte-monnaie ne doit pas casser les notifications déjà reçues.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  message   String
  walletId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
}
